{
  "name": "@jjmhalew/angular-jwt",
  "version": "22.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build angular-jwt --configuration production",
    "postbuild": "cp ./README.md ./CHANGELOG.md ./LICENSE ./dist/angular-jwt/",
    "test": "ng test",
    "test:ci": "npm run test:angular-jwt && npm run test:angular-jwt-demo",
    "test:angular-jwt-demo": "ng test angular-jwt-demo --no-watch --no-progress --browsers=ChromeHeadlessCI --code-coverage",
    "test:angular-jwt": "ng test angular-jwt --no-watch --no-progress --browsers=ChromeHeadlessCI",
    "test:types": "tsd projects/angular-jwt/src",
    "lint": "ng lint",
    "release": "npm publish dist/angular-jwt/"
  },
  "private": false,
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "core-js": "^3.49.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "angular-eslint": "22.0.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^29.1.1",
    "ng-packagr": "^22.0.0",
    "prettier": "^3.8.3",
    "tsd": "^0.33.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  },
  "np": {
    "contents": "dist/angular-jwt"
  },
  "publishConfig": {
    "access": "public"
  }
}
